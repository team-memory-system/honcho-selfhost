<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. CLAUDE_PROXY_SHARED_SECRET below is the placeholder __SECRET__ so that
  this file can live in the git repo without carrying a credential.

  Install (substitutes the real secret from the key file):

    python3 - <<'PY'
    from pathlib import Path
    src = Path('/Users/chenjing/dev/honcho/claude-print-proxy/com.chenjing.claude-print-proxy.plist')
    key = Path('/Users/chenjing/dev/ubionRAG/.secrets/claude-print-proxy.key').read_text().strip()
    dst = Path.home() / 'Library/LaunchAgents/com.chenjing.claude-print-proxy.plist'
    dst.write_text(src.read_text().replace('__SECRET__', key))
    dst.chmod(0o600)
    PY
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.chenjing.claude-print-proxy.plist
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CLAUDE_BIN</key>
		<string>/Users/chenjing/.local/bin/claude</string>
		<key>CLAUDE_PROXY_EFFORT</key>
		<string>low</string>
		<key>CLAUDE_PROXY_SHARED_SECRET</key>
		<string>__SECRET__</string>
		<key>HOME</key>
		<string>/Users/chenjing</string>
		<key>HOST</key>
		<string>127.0.0.1</string>
		<key>PATH</key>
		<string>/Users/chenjing/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PORT</key>
		<string>11446</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.chenjing.claude-print-proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/chenjing/dev/honcho/claude-print-proxy/server.mjs</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/chenjing/.hermes/logs/claude-print-proxy.error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/chenjing/.hermes/logs/claude-print-proxy.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/chenjing/dev/honcho/claude-print-proxy</string>
</dict>
</plist>
