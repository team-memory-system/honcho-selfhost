<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.honcho-mcp-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BRIDGE_ROOT__/.venv/bin/python</string>
    <string>__BRIDGE_ROOT__/server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__BRIDGE_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HONCHO_BASE_URL</key>
    <string>http://127.0.0.1:8001</string>
    <key>HONCHO_WORKSPACE_ID</key>
    <string>memory</string>
    <key>HONCHO_USER_NAME</key>
    <string>user_chen</string>
    <key>HONCHO_ASSISTANT_NAME</key>
    <string>assistant</string>
    <key>HONCHO_MCP_HOST</key>
    <string>127.0.0.1</string>
    <key>HONCHO_MCP_PORT</key>
    <string>8766</string>
    <key>HONCHO_MCP_PATH</key>
    <string>/mcp</string>
    <key>HONCHO_MCP_TIMEOUT</key>
    <string>300</string>
    <key>HONCHO_MCP_TOOL_CONFIG</key>
    <string>__CONFIG_HOME__/honcho/mcp-bridge/tool-config.json</string>
    <key>HONCHO_MCP_BEARER_TOKEN_FILE</key>
    <string>__CONFIG_HOME__/honcho/mcp-bridge/bearer-token</string>
    <key>HONCHO_MCP_REQUIRE_AUTH</key>
    <string>1</string>
    <key>HONCHO_MCP_REQUIRE_TOOL_CONFIG</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/mcp-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/mcp-bridge.error.log</string>
</dict>
</plist>
