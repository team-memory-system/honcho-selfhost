+    async def _refresh_claim(self, aqs_id: str, work_unit_key: str) -> None:
+        """Keep this worker's claim fresh until the work unit is done.
+
+        A claim is otherwise refreshed only when an item finishes. One item that
+        runs longer than STALE_SESSION_TIMEOUT_MINUTES, such as a long dream,
+        then looked abandoned: stale cleanup deleted the claim and another worker
+        ran the same item again while this one was still on it.
+        """
+        while True:
+            await asyncio.sleep(claim_refresh_seconds())
+            try:
+                async with tracked_db("refresh_work_unit_claim") as db:
+                    result = cast(
+                        CursorResult[Any],
+                        await db.execute(
+                            update(models.ActiveQueueSession)
+                            .where(models.ActiveQueueSession.id == aqs_id)
+                            .values(last_updated=func.now())
+                        ),
+                    )
+                    await db.commit()
+            except Exception:
+                logger.exception(
+                    "Failed to refresh the claim on work unit %s", work_unit_key
+                )
+                continue
+            if result.rowcount == 0:
+                logger.warning(
+                    "Claim %s on work unit %s is gone; another worker may take it",
+                    aqs_id,
+                    work_unit_key,
+                )
+                return
