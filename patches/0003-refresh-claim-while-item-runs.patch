+def claim_refresh_seconds() -> float:
+    """How often a worker refreshes its claim while an item is still running.
+
+    Five refreshes fit in the stale timeout, so one slow database write does not
+    let the claim go stale.
+    """
+    return settings.DERIVER.STALE_SESSION_TIMEOUT_MINUTES * 60 / 5
+
