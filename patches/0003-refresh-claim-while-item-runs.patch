+    async def test_claim_stays_fresh_while_one_item_runs_long(
+        self,
+        db_session: AsyncSession,
+        sample_session_with_peers: tuple[models.Session, list[models.Peer]],
+        create_queue_payload: Callable[..., Any],
+        monkeypatch: pytest.MonkeyPatch,
+    ) -> None:
+        """An item running past the stale timeout keeps its claim, so no other worker runs it again."""
+        monkeypatch.setattr(
+            "src.deriver.queue_manager.claim_refresh_seconds", lambda: 0.05
+        )
+        work_unit_key, _queue_items = await self._add_representation_work_unit(
+            db_session=db_session,
+            sample_session_with_peers=sample_session_with_peers,
+            create_queue_payload=create_queue_payload,
+            token_counts=[10],
+        )
+        qm = QueueManager()
+        claimed = await qm.claim_work_units(db_session, [work_unit_key])
+        aqs_id = claimed[work_unit_key]
+        qm.worker_ownership["slow_worker"] = WorkerOwnership(
+            work_unit_key=work_unit_key, aqs_id=aqs_id
+        )
+        # The claim was last refreshed longer ago than the stale timeout.
+        long_ago = datetime.now(UTC) - timedelta(
+            minutes=settings.DERIVER.STALE_SESSION_TIMEOUT_MINUTES * 2
+        )
+        await db_session.execute(
+            update(models.ActiveQueueSession)
+            .where(models.ActiveQueueSession.id == aqs_id)
+            .values(last_updated=long_ago)
+        )
+        await db_session.commit()
+
+        seen: list[datetime | None] = []
+
+        async def slow_batch(*_args: Any, **_kwargs: Any) -> None:
+            await asyncio.sleep(0.3)
+            await qm.cleanup_stale_work_units()
+            seen.append(
+                await db_session.scalar(
+                    select(models.ActiveQueueSession.last_updated).where(
+                        models.ActiveQueueSession.id == aqs_id
+                    )
+                )
+            )
+
+        with patch(
+            "src.deriver.queue_manager.process_representation_batch",
+            side_effect=slow_batch,
+        ):
+            await qm.process_work_unit(work_unit_key, "slow_worker")
+
+        assert len(seen) == 1
+        assert seen[0] is not None, "stale cleanup took the claim of a running item"
+        assert seen[0] > long_ago
+
